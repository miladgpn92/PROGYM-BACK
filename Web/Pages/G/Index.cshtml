@if (showContact)
{
    <div class="fixed inset-0 z-50 hidden " data-contact-container aria-hidden="true">
        <button type="button" class="absolute inset-0 h-full w-full bg-black/60 backdrop-blur-sm" data-contact-dismiss aria-label="بستن پنجره تماس"></button>
        <div class="absolute max-w-lg inset-x-0 bottom-0 right-1/2 translate-x-1/2 w-full translate-y-full rounded-t-[32px] bg-white text-[#121429] shadow-[0_-20px_80px_rgba(0,0,0,0.35)] transition-transform duration-300 ease-out will-change-transform" data-contact-panel role="dialog" aria-modal="true" aria-label="@contactSheetTitle" tabindex="-1">
            <div class="px-6 pt-4 pb-6">
                <div class="mx-auto mb-4 h-1.5 w-16 rounded-full bg-[#D8DFE9]"></div>
                <h2 class="mb-6 text-center text-lg font-bold">@contactSheetTitle</h2>
                <div class="space-y-3">
                    @foreach (var phone in Model.ContactPhones)
                    {
                        <div class="flex items-center justify-between rounded-2xl border border-[#E4E7ED] px-4 py-3 shadow-sm">
                            <div class="flex items-center gap-3">
                                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#E6F2FF] text-[#007AFF]">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none">
                                        <path d="M22 16.92v3a2.08 2.08 0 0 1-2.27 2.08 20.35 20.35 0 0 1-8.86-3.16 19.88 19.88 0 0 1-6.11-6.11 20.35 20.35 0 0 1-3.16-8.88A2.08 2.08 0 0 1 3.68 1.5h3a2.08 2.08 0 0 1 2.08 1.78 13.42 13.42 0 0 0 .73 2.94 2.08 2.08 0 0 1-.47 2.19l-1.27 1.27a16.06 16.06 0 0 0 6.11 6.11l1.27-1.27a2.08 2.08 0 0 1 2.19-.47 13.42 13.42 0 0 0 2.94.73A2.08 2.08 0 0 1 22 16.92Z" fill="currentColor" />
                                    </svg>
                                </span>
                                <span class="text-lg font-semibold tracking-wide" dir="ltr">@phone.Display</span>
                            </div>
                            <a href="@phone.Link" class="rounded-full bg-[#007AFF] px-4 py-2 text-sm font-bold text-white transition hover:bg-[#0066D6]">
                                تماس
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        (() => {
            const container = document.querySelector('[data-contact-container]');
            if (!container) {
                return;
            }

            const panel = container.querySelector('[data-contact-panel]');
            const openers = document.querySelectorAll('[data-contact-open]');
            const dismissButtons = container.querySelectorAll('[data-contact-dismiss]');
            const hiddenClass = 'translate-y-full';
            const activeClass = 'translate-y-0';
            let previousFocus = null;

            const onKeyDown = (event) => {
                if (event.key === 'Escape') {
                    closeSheet();
                }
            };

            const openSheet = () => {
                if (!panel || container.classList.contains('is-open')) {
                    return;
                }

                previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
                container.classList.remove('hidden');
                container.classList.add('is-open');
                container.setAttribute('aria-hidden', 'false');
                document.body.classList.add('overflow-hidden');

                window.requestAnimationFrame(() => {
                    panel.classList.remove(hiddenClass);
                    panel.classList.add(activeClass);
                    panel.focus({ preventScroll: true });
                });

                document.addEventListener('keydown', onKeyDown);
            };

            const closeSheet = () => {
                if (!panel || !container.classList.contains('is-open')) {
                    return;
                }

                panel.classList.remove(activeClass);
                panel.classList.add(hiddenClass);
                container.classList.remove('is-open');
                container.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('overflow-hidden');

                const finish = () => {
                    panel.removeEventListener('transitionend', finish);
                    if (container.classList.contains('is-open')) {
                        return;
                    }

                    container.classList.add('hidden');
                    if (previousFocus) {
                        previousFocus.focus({ preventScroll: true });
                    }
                };

                panel.addEventListener('transitionend', finish, { once: true });
                window.setTimeout(finish, 350);
                document.removeEventListener('keydown', onKeyDown);
            };

            openers.forEach((trigger) => {
                trigger.addEventListener('click', (event) => {
                    event.preventDefault();
                    openSheet();
                });
            });

            dismissButtons.forEach((trigger) => {
                trigger.addEventListener('click', (event) => {
                    event.preventDefault();
                    closeSheet();
                });
            });

            container.addEventListener('click', (event) => {
                if (event.target === container && container.classList.contains('is-open')) {
                    closeSheet();
                }
            });
        })();
    </script>
}
