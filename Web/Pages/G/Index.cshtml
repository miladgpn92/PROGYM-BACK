@page "/g/{slug}"
@model Web.Pages.G.IndexModel
@{
    var gym = Model.Gym;
    var showContact = (Model.ContactPhones?.Count ?? 0) > 0;
    var titleInitial = !string.IsNullOrEmpty(gym?.Title) ? gym.Title.Substring(0, 1) : "?";
    var contactSheetTitle = !string.IsNullOrWhiteSpace(gym?.Title) ? $"تماس {gym.Title}" : "تماس با باشگاه";
}

<div class="min-h-screen bg-[#111215] text-white flex justify-center px-4 py-10 sm:py-16">
    <div class="w-full max-w-lg">
        <div class="rounded-[32px] bg-white text-[#121429] shadow-[0_30px_80px_rgba(0,0,0,0.4)]">
            <div class="flex flex-col items-center gap-5 px-10 pt-8 text-center">
                <div class="flex h-36 w-36 items-center justify-center rounded-3xl bg-[#1A1B1C] overflow-hidden">
                    @if (!string.IsNullOrWhiteSpace(gym?.LogoUrl))
                    {
                        <img src="@gym.LogoUrl" alt="@gym.Title" class="h-full w-full object-cover" />
                    }
                    else
                    {
                        <span class="text-2xl font-bold text-white">@titleInitial</span>
                    }
                </div>

                <div class="space-y-2">
                    <h1 class="text-2xl font-black leading-relaxed text-[#121429]">@gym?.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(gym?.Address))
                    {
                        <p class="text-lg leading-7 text-[#4A4E70]">@gym.Address</p>
                    }
                </div>

