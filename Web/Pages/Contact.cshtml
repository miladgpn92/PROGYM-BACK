@page "/contact"
@model Web.Pages.ContactModel
@{
    ViewData["Title"] ??= "تماس با ما";
}

<div class="min-h-screen bg-[#1A1B1C] text-white flex flex-col pb-24">
    <main class="flex flex-1 flex-col items-center px-6">
        <section class="flex w-full max-w-3xl flex-col items-center text-center py-16 gap-6">
            <span class="rounded-full bg-[#27282C] px-5 py-2 text-sm font-semibold text-white/80">در ارتباط با ما</span>
            <h1 class="text-5xl sm:text-6xl font-black tracking-tight text-white">تماس با ما</h1>
            <p class="max-w-2xl text-base leading-8 text-white/70 sm:text-lg">
                برای هرگونه سوال، همکاری یا پشتیبانی می‌توانید از طریق اطلاعات تماس زیر با تیم پروجیم در ارتباط باشید.
            </p>
        </section>

        <section class="w-full max-w-6xl grid grid-cols-1 gap-6 lg:grid-cols-[1.1fr_1.4fr]">
            <div class="flex flex-col gap-6">
                <div class="rounded-3xl bg-white/5 border border-white/10 p-6 shadow-lg shadow-black/20 backdrop-blur">
                    <h2 class="text-xl font-semibold text-white mb-4">اطلاعات تماس</h2>
                    <div class="space-y-5">
                        @if (Model.Details.HasPhone)
                        {
                            <div class="flex flex-col gap-3">
                                <span class="text-sm font-medium text-white/60">شماره تماس</span>
                                <div class="flex flex-wrap gap-3">
                                    @foreach (var phone in Model.Details.MobileNumbers)
                                    {
                                        <a class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:border-white/40 hover:bg-white/10"
                                           href="@phone.Link">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none">
                                                <path d="M22 16.92v3a2.08 2.08 0 0 1-2.27 2.08 20.35 20.35 0 0 1-8.86-3.16 19.88 19.88 0 0 1-6.11-6.11 20.35 20.35 0 0 1-3.16-8.88A2.08 2.08 0 0 1 3.68 1.5h3a2.08 2.08 0 0 1 2.08 1.78 13.42 13.42 0 0 0 .73 2.94 2.08 2.08 0 0 1-.47 2.19l-1.27 1.27a16.06 16.06 0 0 0 6.11 6.11l1.27-1.27a2.08 2.08 0 0 1 2.19-.47 13.42 13.42 0 0 0 2.94.73A2.08 2.08 0 0 1 22 16.92Z" fill="currentColor" />
                                            </svg>
                                            <span dir="ltr">@phone.Display</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.Details.HasLandline)
                        {
                            <div class="flex flex-col gap-3">
                                <span class="text-sm font-medium text-white/60">شماره ثابت</span>
                                <div class="flex flex-wrap gap-3">
                                    @foreach (var phone in Model.Details.LandlineNumbers)
                                    {
                                        <a class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:border-white/40 hover:bg-white/10"
                                           href="@phone.Link">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none">
                                                <path d="M19.75 2H4.25C3.01 2 2 3.01 2 4.25V17.75C2 18.99 3.01 20 4.25 20H8.5V22C8.5 22.41 8.75 22.77 9.13 22.92C9.26 22.97 9.38 23 9.5 23C9.76 23 10 22.9 10.19 22.71L12.9 20H19.75C20.99 20 22 18.99 22 17.75V4.25C22 3.01 20.99 2 19.75 2ZM20.5 17.75C20.5 18.16 20.16 18.5 19.75 18.5H12.5C12.24 18.5 11.99 18.6 11.81 18.79L10 20.59V19C10 18.59 9.66 18.25 9.25 18.25H4.25C3.84 18.25 3.5 17.91 3.5 17.5V4.25C3.5 3.84 3.84 3.5 4.25 3.5H19.75C20.16 3.5 20.5 3.84 20.5 4.25V17.75Z" fill="currentColor" />
                                            </svg>
                                            <span dir="ltr">@phone.Display</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.Details.HasEmail)
                        {
                            <div class="flex flex-col gap-3">
                                <span class="text-sm font-medium text-white/60">ایمیل</span>
                                <a class="inline-flex items-center gap-2 rounded-2xl bg-[#3986D1]/20 px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#3986D1]/30"
                                   href="mailto:@Model.Details.Email">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none">
                                        <path d="M20 4H4C2.897 4 2 4.897 2 6V18C2 19.103 2.897 20 4 20H20C21.103 20 22 19.103 22 18V6C22 4.897 21.103 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z" fill="currentColor" />
                                    </svg>
                                    <span dir="ltr">@Model.Details.Email</span>
                                </a>
                            </div>
                        }

                        @if (Model.Details.HasAddress)
                        {
                            <div class="flex flex-col gap-3">
                                <span class="text-sm font-medium text-white/60">آدرس</span>
                                <p class="rounded-2xl bg-white/5 border border-white/10 px-4 py-3 text-sm leading-7 text-white/80 text-right">
                                    @Model.Details.Address
                                </p>
                            </div>
                        }
                    </div>
                </div>

                @if (Model.Map.GoogleDirectionsUrl is not null || Model.Map.NeshanDirectionsUrl is not null)
                {
                    <div class="rounded-3xl bg-white/5 border border-white/10 p-6 shadow-lg shadow-black/20 backdrop-blur">
                        <h3 class="text-lg font-semibold text-white mb-4">مسیر یابی سریع</h3>
                        <div class="flex flex-wrap gap-4">
                            @if (!string.IsNullOrWhiteSpace(Model.Map.NeshanDirectionsUrl))
                            {
                                <a class="inline-flex items-center gap-2 rounded-2xl bg-[#00B7A1]/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#00B7A1]/30"
                                   href="@Model.Map.NeshanDirectionsUrl"
                                   target="_blank" rel="noopener">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
                                        <path d="M12 2C7.031 2 3 6.029 3 11C3 17.25 11.254 21.707 11.606 21.889C11.725 21.951 11.862 22 12 22C12.138 22 12.275 21.951 12.394 21.889C12.746 21.707 21 17.25 21 11C21 6.029 16.969 2 12 2ZM12 19.652C9.658 18.26 4.5 14.778 4.5 11C4.5 6.859 7.859 3.5 12 3.5C16.141 3.5 19.5 6.859 19.5 11C19.5 14.776 14.342 18.259 12 19.652Z" fill="currentColor" />
                                        <circle cx="12" cy="11" r="3" fill="currentColor" />
                                    </svg>
                                    نشان
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Map.GoogleDirectionsUrl))
                            {
                                <a class="inline-flex items-center gap-2 rounded-2xl bg-[#4285F4]/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#4285F4]/30"
                                   href="@Model.Map.GoogleDirectionsUrl"
                                   target="_blank" rel="noopener">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
                                        <path d="M12 2C11.735 2 11.48 2.105 11.293 2.293L2.293 11.293C1.902 11.684 1.902 12.316 2.293 12.707L11.293 21.707C11.684 22.098 12.316 22.098 12.707 21.707L21.707 12.707C22.098 12.316 22.098 11.684 21.707 11.293L12.707 2.293C12.52 2.105 12.265 2 12 2ZM12 4.414L19.586 12L17 14.586L12 9.586L7 14.586L4.414 12L12 4.414ZM12 11C11.448 11 11 11.448 11 12V18C11 18.552 11.448 19 12 19C12.552 19 13 18.552 13 18V12C13 11.448 12.552 11 12 11Z" fill="currentColor" />
                                    </svg>
                                    Google Maps
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="rounded-3xl bg-white/5 border border-white/10 overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.35)] backdrop-blur">
                <div class="w-full aspect-[4/3] sm:aspect-[16/9]">
                    @if (!string.IsNullOrWhiteSpace(Model.Map.GoogleEmbedUrl))
                    {
                        <iframe title="موقعیت پروجیم روی نقشه"
                                src="@Model.Map.GoogleEmbedUrl"
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                class="h-full w-full border-0"></iframe>
                    }
                    else
                    {
                        <div class="flex h-full w-full flex-col items-center justify-center gap-3 bg-[#111215]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white/30" viewBox="0 0 24 24" fill="none">
                                <path d="M12 2C7.031 2 3 6.029 3 11C3 17.25 11.254 21.707 11.606 21.889C11.725 21.951 11.862 22 12 22C12.138 22 12.275 21.951 12.394 21.889C12.746 21.707 21 17.25 21 11C21 6.029 16.969 2 12 2ZM12 19.652C9.658 18.26 4.5 14.778 4.5 11C4.5 6.859 7.859 3.5 12 3.5C16.141 3.5 19.5 6.859 19.5 11C19.5 14.776 14.342 18.259 12 19.652Z" fill="currentColor" />
                                <circle cx="12" cy="11" r="3" fill="currentColor" />
                            </svg>
                            <p class="text-sm text-white/50">مختصات ثبت نشده است. لطفاً با ما تماس بگیرید.</p>
                        </div>
                    }
                </div>
                @if (Model.Details.HasAddress)
                {
                    <div class="border-t border-white/10 bg-[#111215] px-6 py-5 text-right">
                        <h3 class="text-sm font-semibold text-white/80 mb-2">آدرس دقیق</h3>
                        <p class="text-sm leading-7 text-white/60">@Model.Details.Address</p>
                    </div>
                }
            </div>
        </section>
    </main>
</div>
